# --- AUTH ---
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.gardentender
# Prefix of the custom claims (email) the Auth0 post-login Action adds to the access token
AUTH0_CLAIMS_NAMESPACE=https://gardentender/

# --- AGENT ---
MAX_TOOL_STEPS=5
ANTHROPIC_API_KEY=
# claude (needs ANTHROPIC_API_KEY) or ollama (needs OLLAMA_BASE_URL and a pulled model)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
# Ollama on the host machine.
#OLLAMA_BASE_URL=http://host.docker.internal:11434 # Use host.docker.internal when the API runs in Docker
OLLAMA_BASE_URL=http://localhost:11434 # Use when running outside of Docker container

# --- DATABASE ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Used by docker compose (the api container reaches the db at host "db")
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=database_name
DB_HOST_PORT=5432

# Manually set the values in the DATABASE_URL when running the api outside docker (uv run uvicorn ...)
# Use 127.0.0.1, not localhost: Docker publishes the port on IPv4 only, and on Windows "localhost" tries IPv6 first,
# which makes every new connection wait ~20s before falling back.
DATABASE_URL=postgresql+asyncpg://{{POSTGRES_USER}}:{{POSTGRES_PASSWORD}}@127.0.0.1:{{DB_HOST_PORT}}/{{POSTGRES_DB}}

# --- GARDENS ---
# Days a deleted garden stays restorable before `python -m app.jobs.purge` removes it
GARDEN_RETENTION_DAYS=15

# --- INVITES & LINKS ---
INVITE_TTL_DAYS=7
QR_INVITE_TTL_MINUTES=15
# Public https origin for emailed/QR links. Locally: your ngrok static domain (see README), e.g. https://yourname.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:8000
EMAIL_BACKEND=console
# Android App Links: package name and the SHA-256 fingerprint(s) of the signing cert (JSON list)
ANDROID_PACKAGE=com.gardentender
ANDROID_CERT_SHA256=[]

# --- DEVELOPMENT ---
# Mount debug-only routes such as GET /debug/whoami. Never enable in production.
DEBUG_ENDPOINTS=false
