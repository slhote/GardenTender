AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.gardentender

MAX_TOOL_STEPS=5
ANTHROPIC_API_KEY=
# claude (needs ANTHROPIC_API_KEY) or ollama (needs OLLAMA_BASE_URL and a pulled model)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
# Ollama on the host machine. Use host.docker.internal when the API runs in Docker, localhost otherwise.
OLLAMA_BASE_URL=http://localhost:11434

# Used by docker compose (the api container reaches the db at host "db")
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=database_name
# Used when running the api outside docker (uv run uvicorn ...)
DATABASE_URL=postgresql+asyncpg://{{POSTGRES_USER}}:{{POSTGRES_PASSWORD}}@localhost:5432/{{POSTGRES_DB}}
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_HOST_PORT=5432
