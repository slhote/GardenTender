# --- AUTH ---
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.gardentender
# Prefix of the custom claims (email) the Auth0 post-login Action adds to the access token
AUTH0_CLAIMS_NAMESPACE=https://gardentender/

# --- AGENT ---
MAX_TOOL_STEPS=5
ANTHROPIC_API_KEY=
# claude (needs ANTHROPIC_API_KEY) or ollama (needs OLLAMA_BASE_URL and a pulled model)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
# Ollama on the host machine.
#OLLAMA_BASE_URL=http://host.docker.internal:11434 # Use host.docker.internal when the API runs in Docker
OLLAMA_BASE_URL=http://localhost:11434 # Use when running outside of Docker container

# --- DATABASE ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Used by docker compose (the api container reaches the db at host "db")
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=database_name
DB_HOST_PORT=5432

# Manually set the values in the DATABASE_URL when running the api outside docker (uv run uvicorn ...)
DATABASE_URL=postgresql+asyncpg://{{POSTGRES_USER}}:{{POSTGRES_PASSWORD}}@localhost:{{DB_HOST_PORT}}/{{POSTGRES_DB}}

# --- GARDENS ---
# Days a deleted garden stays restorable before `python -m app.jobs.purge` removes it
GARDEN_RETENTION_DAYS=15
